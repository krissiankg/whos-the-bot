{
  "name": "whos-the-bot",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:core": "node --env-file=.env.local scripts/test-core-public.mjs",
    "test:admin": "node --env-file=.env.local scripts/test-admin-public.mjs",
    "test:lobby": "node --env-file=.env.local scripts/test-lobby.mjs",
    "test:languages": "node --env-file=.env.local scripts/test-languages-public.mjs",
    "verify:build": "node scripts/verify-next.mjs build --webpack",
    "verify:start": "node scripts/verify-next.mjs start --hostname 0.0.0.0 --port 3100"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
